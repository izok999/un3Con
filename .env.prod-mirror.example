# =============================================================================
# .env.prod-mirror.example — entorno del espejo de produccion
#
#   cp .env.prod-mirror.example .env.prod-mirror
#
# Base: migrate/env.production.example. Cada linea que se APARTA de produccion
# esta marcada con [DELTA] y explicada. No agregues deltas sin anotarlos: son
# exactamente lo que invalida una prueba de carga.
# =============================================================================

# -----------------------------------------------------------------------------
# Aplicacion
# -----------------------------------------------------------------------------
APP_NAME="Consultor"
APP_ENV=production
APP_KEY=                            # docker compose -f compose.prod-mirror.yaml run --rm app php artisan key:generate --show
APP_DEBUG=false
APP_TIMEZONE=America/Asuncion

# [DELTA] produccion: https://www.une.edu.py/consultor
# El espejo no tiene Cloudflare adelante, sirve HTTP plano en localhost.
APP_URL=http://localhost:8080

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_PY

# -----------------------------------------------------------------------------
# Octane
# -----------------------------------------------------------------------------
OCTANE_SERVER=frankenphp
OCTANE_HTTPS=false                  # igual que produccion: el TLS termina antes

# -----------------------------------------------------------------------------
# DB local — via PgBouncer, igual que produccion
# -----------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=pgbouncer                   # [DELTA] produccion: 127.0.0.1 (mismo host)
DB_PORT=6432                        # PgBouncer, NO el 5432 directo
DB_DATABASE=consultor_db
DB_USERNAME=consultor_user
DB_PASSWORD=cambiar_esto
DB_SCHEMA=public

# config/database.php ya trae PDO::ATTR_EMULATE_PREPARES => true, obligatorio
# con pool_mode=transaction. No hace falta nada mas aca.

# -----------------------------------------------------------------------------
# DB legacy — conexion DIRECTA, sin PgBouncer, igual que produccion
#
# ####  APUNTA A LA BASE PRODUCTIVA REAL  ####
#
# Dato util para dimensionar el riesgo: la cantidad de conexiones contra la
# legacy esta acotada por la cantidad de workers de Octane (Laravel mantiene un
# PDO por worker), NO por la concurrencia de requests. Con 4 workers son 4
# conexiones aunque le tires 1000 req/s. Y usr_alu_web es de solo lectura.
#
# O sea: no la vas a tumbar por agotamiento de conexiones ni vas a corromper
# nada. Lo que si podes hacer es saturarle CPU/IO por VOLUMEN de queries.
# Por eso el generador de carga viene limitado por RPS (LOAD_RPS) y no por VUs.
#
# Antes de subir la intensidad: coordina la ventana con el equipo que la
# administra y arranca por LOAD_STAGE=smoke.
# -----------------------------------------------------------------------------
DB_EXTERNA_CONNECTION=pgsql_externa
DB_EXTERNA_HOST=10.10.254.252
DB_EXTERNA_PORT=5432
DB_EXTERNA_DATABASE=une_base
DB_EXTERNA_USERNAME=usr_alu_web
DB_EXTERNA_PASSWORD=cambiar_esto
DB_EXTERNA_SEARCH_PATH=sh_movimientos,sh_maestros,public
DB_EXTERNA_SSLMODE=prefer

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
# [DELTA / A REVISAR] migrate/env.production.example dice REDIS_CLIENT=predis.
# predis es PHP puro y bastante mas lento que la extension phpredis; con cache,
# sesiones y colas todas sobre Redis, esa eleccion se nota bajo carga. El .env
# de desarrollo ya usa phpredis. El espejo usa phpredis; si produccion se queda
# en predis, cambialo aca o vas a medir de menos.
REDIS_CLIENT=phpredis
REDIS_HOST=redis                    # [DELTA] produccion: 127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_CACHE_DB=0
REDIS_QUEUE_DB=1
REDIS_SESSION_DB=2

CACHE_STORE=redis
CACHE_PREFIX=consultor_
QUEUE_CONNECTION=redis

# -----------------------------------------------------------------------------
# Sesiones
# -----------------------------------------------------------------------------
SESSION_DRIVER=redis
SESSION_LIFETIME=480
SESSION_ENCRYPT=true

# [DELTA] produccion: true.
# El espejo sirve HTTP plano, y con secure_cookie=true el cliente nunca devuelve
# la cookie de sesion — no podrias ni loguearte, menos hacer una prueba del
# flujo de login. Es el unico delta que cambia comportamiento de la app.
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# -----------------------------------------------------------------------------
# Logs
# -----------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=daily,stderr
LOG_LEVEL=error                     # igual que produccion: subilo solo para debuggear
LOG_DAILY_DAYS=14

# -----------------------------------------------------------------------------
# Correo — al Mailpit del stack de Sail, para no mandar nada real
# -----------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=host.docker.internal
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="servicios@une.edu.py"
MAIL_FROM_NAME="${APP_NAME}"

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
VITE_APP_NAME="${APP_NAME}"


# =============================================================================
# Parametros del espejo (no son del .env de produccion)
# =============================================================================

# --- Recursos ----------------------------------------------------------------
# AJUSTAR A LOS DEL SERVER REAL. Mientras no coincidan, los numeros no sirven.
#
# cpuset pinea cores fisicos y por lo tanto cambia lo que ve nproc, que es lo
# que Octane usa para --workers=auto. `cpus:` NO sirve para esto: es una cuota.
MIRROR_APP_CPUSET=0-3
MIRROR_APP_MEM=4g
MIRROR_WORKER_CPUSET=4-5
MIRROR_WORKER_MEM=2g

# Aun con cpuset, lo mas seguro es fijar los workers al valor de produccion.
# Sacalo del server con: systemctl status consultor-octane
OCTANE_WORKERS=auto
OCTANE_TASK_WORKERS=auto
OCTANE_MAX_REQUESTS=500

# --- PostgreSQL --------------------------------------------------------------
# VERIFICAR contra `SELECT version();` en produccion. setup-server.sh no instala
# PostgreSQL, asi que la version del server no esta documentada en el repo.
POSTGRES_VERSION=18
POSTGRES_MAX_CONNECTIONS=100
POSTGRES_SHARED_BUFFERS=256MB
POSTGRES_LOG_MIN_DURATION=500       # loguea queries de mas de 500ms

# --- Nginx -------------------------------------------------------------------
# false = reproduce produccion tal cual, con el rate limiting global roto.
# true  = aplica el fix de real_ip y limita por cliente. Ver docker/prod/README.md
MIRROR_FIX_REAL_IP=false

# --- Puertos publicados ------------------------------------------------------
MIRROR_HTTP_PORT=8080
MIRROR_PG_PORT=55432
MIRROR_REDIS_PORT=56379
MIRROR_PGBOUNCER_PORT=6432

# --- Otros -------------------------------------------------------------------
MIRROR_RUN_MIGRATIONS=true
MIRROR_PGBOUNCER_VERBOSE=

# --- Generador de carga ------------------------------------------------------
# LOAD_STAGE: smoke | ramp | sustained   (ver docker/prod/loadtest/load.js)
# ARRANCA SIEMPRE EN smoke. La legacy es productiva.
LOAD_STAGE=smoke
LOAD_RPS=5
LOAD_DURATION=2m
LOAD_MAX_VUS=20
LOAD_VHOST=www.une.edu.py
